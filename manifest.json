{
  "schemaVersion": 1,
  "id": "linux-alchemy.omasound-dev",
  "name": "OmaSound Fixture",
  "version": "0.1.0",
  "author": "Linux-Alchemy",
  "description": "Isolated audio-control fixture; does not change sound",

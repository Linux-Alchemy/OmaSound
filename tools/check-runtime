#!/usr/bin/env python3
"""Exercise the real Quickshell process bridge in an isolated offscreen runtime."""
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile

repo = Path(__file__).resolve().parents[1]
with tempfile.TemporaryDirectory(prefix='omasound-runtime-') as temporary:
    root = Path(temporary)
    for folder in ('models', 'adapters', 'helpers'):
        shutil.copytree(repo / folder, root / folder, ignore=shutil.ignore_patterns('__pycache__'))
    for file in ('Service.qml', 'RuntimeService.qml'):
        shutil.copy(repo / file, root / file)
    shutil.copy(repo / 'tests/runtime/persistence.qml', root / 'shell.qml')
    env = {**os.environ, 'QT_QPA_PLATFORM':'offscreen', 'QT_QPA_PLATFORMTHEME':'generic',
           'QT_QUICK_CONTROLS_STYLE':'Basic', 'OMASOUND_TEST_STATE_HOME':str(root / 'state'),
           'XDG_CACHE_HOME':str(root / 'cache'), 'XDG_CONFIG_HOME':str(root / 'config'), 'XDG_RUNTIME_DIR':str(root)}
    env.pop('WAYLAND_DISPLAY', None); env.pop('DISPLAY', None)
    with tempfile.TemporaryFile() as output:
        proc = subprocess.Popen(['quickshell', '--no-color', '-p', str(root)], stdout=output,
                                stderr=subprocess.STDOUT, env=env, start_new_session=True)
        try:
            code = proc.wait(timeout=55)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL); proc.wait(); code = 1
        output.seek(0); text = output.read(1024 * 1024).decode(errors='replace')
        print(text, end='')
        if code or 'OMASOUND_TEST_COMPLETE 7' not in text or 'OMASOUND_TEST_FAIL' in text or ' WARN' in text or ' ERROR' in text:
            raise SystemExit('FAIL runtime persistence checks')
print('PASS seven real-helper persistence scenarios; disposable runtime removed')

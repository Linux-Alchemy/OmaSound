#!/usr/bin/env python3
"""Foundation gate. Start the fixture preview explicitly before this command."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

from preview_lib import FILES, PLUGIN_ID, Preview, PreviewError, digest, read_regular

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--scope", required=True)
args = parser.parse_args()
if args.scope != "foundation":
    parser.error(f"Scope {args.scope!r} is not implemented; no gate passed")
repo = Path(__file__).resolve().parents[1]
os.chdir(repo)


def run(argv):
    print("$ " + " ".join(map(str, argv)), flush=True)
    subprocess.run(argv, check=True, timeout=60)


try:
    with tempfile.TemporaryDirectory(prefix="omasound-check-") as temporary:
        root = Path(temporary)
        staged = root / "plugin"
        for name in FILES:
            target = staged / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(read_regular(repo / name))
        run(["omarchy", "plugin", "validate", str(staged)])
        imports = root / "imports"
        imports.mkdir()
        (imports / "qs").symlink_to("/usr/share/omarchy/shell", target_is_directory=True)
        qml = sorted(str(p) for p in repo.glob("*.qml")) + sorted(str(p) for p in (repo / "ui").glob("*.qml"))
        if len(qml) != 6:
            raise PreviewError("Expected six foundation QML files; update the explicit check coverage if the component set changes")
        run(["/usr/lib/qt6/bin/qmllint", "--ignore-settings", "-W", "0", "-I", str(imports), *qml])
        for name in qml:
            formatted = subprocess.run(["/usr/lib/qt6/bin/qmlformat", name], check=True, capture_output=True, timeout=15)
            if formatted.stderr or formatted.stdout != Path(name).read_bytes():
                raise PreviewError(f"QML format differs or warned: {name}; run /usr/lib/qt6/bin/qmlformat -i")
        print("Qt 6 QML formatting: all six files match", flush=True)
    run(["/usr/bin/node", "--test", "--test-isolation=none", "tests/unit/fixture.test.cjs"])
    suite = unittest.TestLoader().discover("tests/integration", pattern="test_*.py")
    if suite.countTestCases() < 12:
        raise PreviewError("Missing required foundation preview tests (expected at least twelve)")
    run([sys.executable, "-m", "unittest", "discover", "-s", "tests/integration", "-p", "test_*.py", "-v"])
    run(["git", "diff", "--check"])
    ignored = subprocess.run(["git", "check-ignore", "PLAN.md", "local/evidence/phase-1"], capture_output=True, text=True, check=True)
    if set(ignored.stdout.splitlines()) != {"PLAN.md", "local/evidence/phase-1"}:
        raise PreviewError("Private plan/evidence ignore contract changed")
    tracked = subprocess.run(["git", "ls-files", "PLAN.md", "local/"], capture_output=True, text=True, check=True)
    if tracked.stdout:
        raise PreviewError("Private files are tracked")
    preview = Preview(repo, Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))))
    with preview.locked():
        record = preview.load_record()
        for name in FILES:
            if digest(read_regular(repo / name)) != record["hashes"].get(name):
                raise PreviewError("Running preview does not match this checkout; stop and restart it")
        status = preview.wait_status(True)
        if (status.get("width"), status.get("height")) != (1200, 800):
            raise PreviewError(f"Fixture geometry differs: {status}")
        print("Host fixture load: " + json.dumps(status), flush=True)
        for _ in range(2):
            if preview.call("summon", PLUGIN_ID, "{}") != "ok":
                raise PreviewError("Host refused repeated open")
            if preview.wait_status(True)["instance"] != status["instance"]:
                raise PreviewError("Repeated open replaced the window instance")
        preview.call("hide", PLUGIN_ID)
        if preview.wait_status(False)["instance"] != status["instance"]:
            raise PreviewError("Close destroyed the persistent panel instance")
        preview.call("summon", PLUGIN_ID, "{}")
        if preview.wait_status(True)["instance"] != status["instance"]:
            raise PreviewError("Reopen replaced the window instance")
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, check=True, timeout=5).stdout)
        owned = [c for c in clients if c.get("title") == "OmaSound — Fixture" and c.get("class") == "org.quickshell"]
        if len(owned) != 1 or not owned[0].get("floating") or owned[0].get("size") != [1200, 800]:
            raise PreviewError("Expected exactly one floating 1200 × 800 fixture client")
        print("Host lifecycle: repeated open, close/reopen retain one instance; compositor confirms one floating 1200 × 800 window", flush=True)
    print("PASS foundation — static/unit checks and matching host fixture loaded; Matt's lifecycle acceptance remains separate")
except (OSError, ValueError, PreviewError, subprocess.SubprocessError) as error:
    print(f"FAIL foundation: {error}", file=sys.stderr)
    sys.exit(1)
